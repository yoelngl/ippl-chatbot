POSTGRES_USER=app
POSTGRES_PASSWORD=app_dev_password
POSTGRES_DB=app

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=dev
KEYCLOAK_CLIENT_ID=fastapi-app

OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
ALLOW_MOCK_EMBEDDING=false

# Ambang relevansi RAG (kalibrasi: make calibrate)
RAG_SIMILARITY_THRESHOLD=0.7

# Batas kueri & log audit
MAX_QUERY_CHARS=2000
AUDIT_QUERY_MAX_CHARS=1000
# Retensi log audit (hari, minimal 30) - jalankan: make audit-retention
AUDIT_RETENTION_DAYS=365

# Peringatan keamanan: N kejadian berisiko dalam jendela waktu -> SECURITY_ALERT
SECURITY_ALERT_THRESHOLD=5
SECURITY_ALERT_WINDOW_MINUTES=10
SECURITY_AUTO_TERMINATE=false

# Profil produksi (make up-prod)
BACKEND_WORKERS=4
HTTPS_PORT=443
HTTP_PORT=80
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400


# Penyedia model: "ollama" (lokal) atau "custom" (endpoint kompatibel OpenAI, mis. 9router, OpenRouter, vLLM).
# Jika keduanya "custom", service ollama tak diperlukan (hapus dari depends_on / jangan dijalankan).
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama
CUSTOM_BASE_URL=http://localhost:20128/v1
CUSTOM_API_KEY=
CUSTOM_MODEL=gpt-4o-mini
CUSTOM_EMBED_MODEL=text-embedding-3-small

# Port host Postgres (ubah bila 5432 sudah dipakai)
POSTGRES_HOST_PORT=5432
